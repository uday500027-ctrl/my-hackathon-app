# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. NEVER prefix secrets with NEXT_PUBLIC_.

# Supabase (Project Settings -> API Keys)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT signing secret — must be at least 32 random characters
JWT_SECRET=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Demo account seed configuration (optional)
# DEMO_PASSWORD=
# Run seed with: npm run seed:demo
# (or: npx tsx --env-file=.env.local scripts/seed-demo.ts)

# Public — safe for the browser
NEXT_PUBLIC_APP_URL=