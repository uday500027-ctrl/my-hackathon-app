# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. NEVER prefix secrets with NEXT_PUBLIC_.

# Google Gemini (get from Google AI Studio)
GEMINI_API_KEY="your-gemini-api-key"

# Supabase (Project Settings -> API Keys / Data API)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-secret-key"

# Optional: only needed if using an ORM (Supabase Connect -> Transaction pooler)
DATABASE_URL="postgresql://postgres.your-project-id:your-password@your-region.pooler.supabase.com:6543/postgres"

# Public (safe for the browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"